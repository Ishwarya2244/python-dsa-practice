#1. binary search problem 

arr = [10, 20, 30, 40, 50, 60, 70]
target = 70
low = 0 
high = len(arr)-1
while(low <= high):
  mid = (low + high) // 2
  if target == arr[mid]:
    print("found at index",mid)
    break
  elif target > arr[mid]:
    low=mid+1
  else:
    high = mid-1


