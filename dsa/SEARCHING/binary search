#3.Find 25 in this sorted array

arr = [5, 10, 15, 20, 25, 30, 35]
target = 25
low =0
high = len(arr)-1
while(low <= high):
  mid = (low+high)//2
  if target == arr[mid]:
    print("found at index",mid)
    break
  elif target < arr[mid]:
    high = mid -1
  else:
