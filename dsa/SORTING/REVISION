#Challenge 1 — Bubble Sort
#Sort this list in ascending order:

arr=[40,10,30,20]
for i in range(len(arr)-1):
  for j in range(len(arr)-1-i):
    if arr[j]>arr[j+1]:
      arr[j],arr[j+1]=arr[j+1],arr[j]
print(arr)

#2.Challenge 2 — Selection Sort

arr = [40, 10, 30, 20]
for i in range(len(arr)):
  min_index = i
  for j in range(i+1,len(arr)):
    if arr[j]<arr[min_index]:
      min_index = j
  arr[i],arr[min_index]=arr[min_index],arr[i]
print(arr)

#3.Challenge 3 — Insertion Sort

arr = [40, 10, 30, 20]
for i in range(1,len(arr)):
  key = arr[i]
  j=i-1
  while j >=0 and arr[j]>key:
    arr[j+1]=arr[j]
    j-=1
  arr[j+1]=key
print(arr)

Bubble Sort: Compares adjacent elements and swaps them.

Selection Sort: Finds the smallest element and swaps it into position.

Insertion Sort: Takes an element and inserts it into the correct position.
