def count_words(text):
    text = text.lower()
    words = text.split()
    word_counts = {}
    
    for word in words:
        if word in word_counts:
            word_counts[word] = word_counts[word] + 1
        else:
            word_counts[word] = 1
            
    return word_counts

print(count_words("AI is future and AI is evolving"))
