#1. Unique Characters

s = "hello"
freq={}
for i in s:
  if i in freq:
    freq[i]=freq[i]+1
  else:
    freq[i]=1
for i in freq:
  if freq[i] > 1:
    print("Not Unique")
    break
else:
  print("unique")

#2. find the longest word

s = "I love programming"
words = s.split()
longest = words[0]
for i in words:
  if len(i)>len(longest):
    longest = i
print(longest)


